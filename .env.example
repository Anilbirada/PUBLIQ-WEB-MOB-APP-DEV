# =========================================================================
# PUBLIQ BAR & RESTAURANT - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your environment values.
# NEVER commit .env or sensitive secrets to version control.
# =========================================================================

# --- DATABASE CONFIGURATION ---
# Local SQLite fallback: sqlite:///./publiq.db
# Local PostgreSQL: postgresql://postgres:postgrespassword2026@localhost:5433/publiq_db
# Render Managed PostgreSQL: postgresql://username:password@hostname/database_name
DATABASE_URL=sqlite:///./publiq.db
SQL_ECHO=false

# --- APPLICATION & SECURITY SECRETS ---
PROJECT_NAME="PUBLIQ Bar & Restaurant Enterprise Platform"
VERSION=2.0.0
# Secret key for JWT & HMAC cryptographic tokens (Minimum 32 random characters)
SECRET_KEY=publiq_luxury_dining_hmac_secret_2026_secure_key_9945321367
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- TABLE QR CRYPTOGRAPHIC SALT ---
# Cryptographic salt for tamper-proof table QR code HMAC generation
QR_TOKEN_SALT=publiq_secure_qr_salt_2026_luxury_hmac_sha256_salt
QR_TOKEN_EXPIRY_HOURS=24

# --- NETWORK & URL ROUTING ---
WEB_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:8001/api/v1
PORT=8001

# --- POS INTEGRATION MODE ---
# Options: "LOCAL_EMULATOR" (built-in offline POS sync) or "DIRECT_API"
POS_INTEGRATION_MODE=LOCAL_EMULATOR

# --- TAX & CHARGES CONFIGURATION (Indian Restaurant GST) ---
# Total 5% Non-ITC Hospitality GST = 2.5% CGST + 2.5% SGST
TAX_RATE_CGST=0.025
TAX_RATE_SGST=0.025
PACKAGING_CHARGE_TAKEAWAY=25.0
DELIVERY_FEE_FLAT=40.0
